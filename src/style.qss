/* ==========================================================================
   style.qss  -  forced dark theme
   All colour values are explicit so no role falls back to the OS palette.
   ========================================================================== */

/* -- Global reset ---------------------------------------------------------- */
* {
    font-family: "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
    color: #e2e8f0;
    /* Prevent any widget from inheriting a light background from the OS */
    background-color: transparent;
}

/* -- Top-level surfaces -- */
QMainWindow,
QMainWindow > QWidget,
QWidget#central,
QStackedWidget {
    background-color: #0f1117;
}

QDialog {
    background-color: #0f1117;
}

/* Generic QWidget fallback (catches dialogs, message boxes, etc.) */
QWidget {
    background-color: #0f1117;
    color: #e2e8f0;
}

/* -- Message / Info boxes -- */
QMessageBox {
    background-color: #0f1117;
    color: #e2e8f0;
}

QMessageBox QLabel {
    color: #e2e8f0;
    background-color: transparent;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* -- Tool tips -- */
QToolTip {
    background-color: #1a1d27;
    color: #e2e8f0;
    border: 1px solid #1e2130;
    padding: 4px 8px;
    border-radius: 4px;
}

/* -- Generic frames -- */
QFrame {
    background-color: transparent;
}

QFrame#card {
    background-color: #1a1d27;
    border-radius: 16px;
}

QFrame#sidebar {
    background-color: #13151f;
    border-right: 1px solid #1e2130;
}

QFrame#content {
    background-color: transparent;
}

QFrame#statCard {
    background-color: #1a1d27;
    border-radius: 12px;
}

QFrame#tableContainer {
    background-color: #1a1d27;
    border-radius: 12px;
}

QFrame#tableHeader {
    background-color: #13151f;
    border-radius: 6px;
}

QFrame#rowDivider {
    background-color: #1e2130;
}

QFrame#formSection {
    background-color: #1a1d27;
    border-radius: 12px;
}

/* -- Labels -- */
QLabel {
    background-color: transparent;
    color: #e2e8f0;
}

QLabel#appTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f1f5f9;
}

QLabel#pageTitle {
    font-size: 24px;
    font-weight: 700;
    color: #f1f5f9;
}

QLabel#subtitle {
    font-size: 13px;
    color: #64748b;
}

QLabel#sectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: #475569;
    letter-spacing: 1px;
}

QLabel#fieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #94a3b8;
}

QLabel#statValue {
    font-size: 28px;
    font-weight: 700;
    color: #f1f5f9;
}

QLabel#statTitle {
    font-size: 12px;
    color: #64748b;
}

QLabel#statSub {
    font-size: 11px;
    color: #475569;
}

QLabel#statIcon {
    font-size: 26px;
}

QLabel#errorLabel {
    font-size: 12px;
    color: #ef4444;
}

QLabel#successLabel {
    font-size: 12px;
    color: #22c55e;
}

QLabel#userLabel {
    font-size: 12px;
    color: #64748b;
}

QLabel#sectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #f1f5f9;
}

QLabel#hintLabel {
    font-size: 12px;
    font-style: italic;
    color: #64748b;
}

QLabel#statusBadge {
    color: #ffffff;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#tableHeaderCell {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    background-color: transparent;
}

QLabel#tableCell {
    font-size: 12px;
    color: #cbd5e1;
    background-color: transparent;
}

/* -- Inputs -- */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #13151f;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 8px 12px;
    color: #e2e8f0;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #3b82f6;
}

QLineEdit:disabled,
QTextEdit:disabled {
    background-color: #13151f;
    color: #475569;
    border-color: #1e2130;
}

QLineEdit::placeholder,
QPlainTextEdit::placeholder {
    color: #475569;
}

/* -- Combo box -- */
QComboBox {
    background-color: #13151f;
    border: 1px solid #1e2130;
    border-radius: 8px;
    padding: 8px 12px;
    color: #e2e8f0;
    min-height: 36px;
}

QComboBox:focus {
    border: 1px solid #3b82f6;
}

QComboBox:disabled {
    color: #475569;
    border-color: #1e2130;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #1a1d27;
    border: 1px solid #1e2130;
    border-radius: 8px;
    color: #e2e8f0;
    selection-background-color: #1e3a5f;
    selection-color: #e2e8f0;
    outline: none;
}

/* -- Buttons -- */
QPushButton {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2563eb;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton:disabled {
    background-color: #1e3a5f;
    color: #475569;
}

QPushButton#navBtn {
    background-color: transparent;
    color: #94a3b8;
    text-align: left;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#navBtn:hover {
    background-color: #1e2130;
    color: #e2e8f0;
}

QPushButton#navBtnActive {
    background-color: #1e2d4d;
    color: #60a5fa;
    text-align: left;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#logoutBtn {
    background-color: transparent;
    color: #ef4444;
    text-align: left;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
}

QPushButton#logoutBtn:hover {
    background-color: #2d1515;
}

QPushButton#cancelBtn {
    background-color: transparent;
    color: #94a3b8;
    border: 1px solid #1e2130;
}

QPushButton#cancelBtn:hover {
    background-color: #1e2130;
    color: #e2e8f0;
}

QPushButton#secondaryBtn {
    background-color: #1e2d4d;
    color: #60a5fa;
    border: 1px solid #1e3a5f;
}

QPushButton#secondaryBtn:hover {
    background-color: #1e3a5f;
    color: #93c5fd;
}

QPushButton#secondaryBtn:disabled {
    background-color: #13151f;
    color: #475569;
    border-color: #1e2130;
}

/* -- Radio buttons -- */
QRadioButton {
    color: #94a3b8;
    spacing: 6px;
    background-color: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #475569;
    background-color: transparent;
}

QRadioButton::indicator:checked {
    border: 2px solid #3b82f6;
    background-color: #3b82f6;
}

/* -- Check boxes -- */
QCheckBox {
    color: #94a3b8;
    spacing: 6px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 2px solid #475569;
    background-color: transparent;
}

QCheckBox::indicator:checked {
    border: 2px solid #3b82f6;
    background-color: #3b82f6;
}

/* -- Table / list views -- */
QTableView,
QTreeView,
QListView {
    background-color: #1a1d27;
    alternate-background-color: #13151f;
    color: #e2e8f0;
    border: none;
    gridline-color: #1e2130;
    selection-background-color: #1e2d4d;
    selection-color: #e2e8f0;
    outline: none;
}

QTableView::item,
QTreeView::item,
QListView::item {
    color: #e2e8f0;
    background-color: transparent;
    padding: 4px 8px;
}

QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: #1e2d4d;
    color: #e2e8f0;
}

QTableView::item:hover,
QTreeView::item:hover,
QListView::item:hover {
    background-color: #1e2130;
}

/* -- Header views (QTableView column headers) -- */
QHeaderView {
    background-color: #13151f;
    color: #64748b;
}

QHeaderView::section {
    background-color: #13151f;
    color: #64748b;
    border: none;
    border-bottom: 1px solid #1e2130;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
}

QHeaderView::section:hover {
    background-color: #1e2130;
    color: #94a3b8;
}

/* -- File queue list -- */
QListWidget#fileQueue {
    background-color: transparent;
    border: none;
    color: #e2e8f0;
}

QListWidget#fileQueue::item {
    background-color: #13151f;
    border-radius: 6px;
    padding: 8px 12px;
}

QListWidget#fileQueue::item:selected {
    background-color: #1e2d4d;
}

QListWidget#fileQueue::item:hover {
    background-color: #1e2130;
}

/* -- Scroll area -- */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #1e2130;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2d3348;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #1e2130;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2d3348;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* -- Menu bar & menus -- */
QMenuBar {
    background-color: #0f1117;
    color: #e2e8f0;
}

QMenuBar::item {
    background-color: transparent;
    color: #e2e8f0;
    padding: 4px 10px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #1e2130;
}

QMenu {
    background-color: #1a1d27;
    color: #e2e8f0;
    border: 1px solid #1e2130;
    padding: 4px 0;
}

QMenu::item {
    background-color: transparent;
    color: #e2e8f0;
    padding: 6px 24px 6px 12px;
}

QMenu::item:selected {
    background-color: #1e2d4d;
    color: #e2e8f0;
}

QMenu::separator {
    height: 1px;
    background-color: #1e2130;
    margin: 4px 0;
}

/* -- Splitter -- */
QSplitter::handle {
    background-color: #1e2130;
}

/* -- Status bar -- */
QStatusBar {
    background-color: #0f1117;
    color: #64748b;
}

/* -- Form layouts (label text inside QFormLayout) -- */
QFormLayout QLabel {
    color: #94a3b8;
    background-color: transparent;
}

/* -- Completer popup -- */
QAbstractItemView {
    background-color: #1a1d27;
    color: #e2e8f0;
    border: 1px solid #1e2130;
    selection-background-color: #1e3a5f;
    selection-color: #e2e8f0;
    outline: none;
}
